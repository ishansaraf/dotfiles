export PATH="$HOME/.local/bin:$PATH"
export EDITOR=hx VISUAL=hx
export PAGER=less LESS=-FRX
# ansi makes bat and delta use the terminal's 16-color palette, i.e. Gruvbox Material.
export BAT_THEME=ansi

HISTFILE=~/.zsh_history
HISTSIZE=200000
SAVEHIST=200000
setopt extended_history share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks
setopt auto_cd auto_pushd pushd_ignore_dups interactive_comments no_beep

# Offer a fix when a command name is mistyped (`gti` -> `git`). Only the command
# word is checked; correct_all would also "fix" arguments like file names.
setopt correct
SPROMPT='zsh: correct %F{red}%R%f to %F{green}%r%f? [nyae] '
CORRECT_IGNORE='[_.]*'

# ~/dotfiles/zsh/completions is vendored; site-functions is generated by personalize.
fpath=(~/dotfiles/zsh/completions ~/.local/share/zsh/site-functions $fpath)
mkdir -p ~/.cache/zsh
autoload -Uz compinit && compinit -d ~/.cache/zsh/zcompdump
autoload -Uz bashcompinit && bashcompinit
command -v aws_completer >/dev/null && complete -C aws_completer aws

eval "$(dircolors -b)"
zstyle ':completion:*' menu select
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.cache/zsh/compcache
# Tab-time typo correction: plain completion first, then spelling fixes, then
# fuzzy matches allowing one error per three typed characters.
zstyle ':completion:*' completer _extensions _complete _correct _approximate
zstyle -e ':completion:*:approximate:*' max-errors 'reply=($(( ($#PREFIX + $#SUFFIX) / 3 > 1 ? ($#PREFIX + $#SUFFIX) / 3 : 1 )) numeric)'
# Case-insensitive, then `f.b<Tab>` -> foo.bar, then substring matches.
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:corrections' format '%F{red}-- %d (errors: %e) --%f'
zstyle ':completion:*:warnings' format '%F{red}-- no matches --%f'

# `bazel` is the Aspect CLI, which intercepts the `bazel help completion` that
# Bazel's _bazel script needs, so completion calls the Bazel binary Aspect
# launches. Both share one server, so this never restarts a running build.
_bazel_for_completion() {
  local root version arch bin
  root=$(git rev-parse --show-toplevel 2>/dev/null) && [[ -f $root/.bazelversion ]] && version=$(<$root/.bazelversion)
  arch=$(uname -m); [[ $arch == aarch64 ]] && arch=arm64
  bin=~/.cache/bazelisk/downloads/bazelbuild/bazel-$version-linux-$arch/bin/bazel
  if [[ -n $version && -x $bin ]]; then "$bin" "$@"; else command bazel "$@"; fi
}
BAZEL=_bazel_for_completion

# zsh picks vi mode when $EDITOR contains "vi" and stays emacs otherwise; set it explicitly.
bindkey -e
WORDCHARS=${WORDCHARS//\/}

autoload -Uz up-line-or-beginning-search down-line-or-beginning-search edit-command-line
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
zle -N edit-command-line
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search
bindkey '^X^E' edit-command-line
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border
  --color=bg+:#3c3836,bg:-1,fg:#d4be98,fg+:#ddc7a1,hl:#d8a657,hl+:#d8a657
  --color=border:#5a524c,header:#7daea3,info:#89b482,marker:#a9b665,pointer:#e78a4e,prompt:#a9b665,spinner:#89b482'
[[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh

alias ls='eza --group-directories-first'
alias ll='eza -l --git --group-directories-first'
alias la='eza -la --git --group-directories-first'
alias tree='eza --tree'
alias g=git
alias gs='git status -sb'
alias lg='git log --graph --oneline --decorate'

# Attach to the named tmux session, creating it if needed: `t`, `t dirt`.
t() { tmux new-session -A -s "${1:-main}"; }

command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v direnv >/dev/null && eval "$(direnv hook zsh)"
command -v starship >/dev/null && eval "$(starship init zsh)"

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

[[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# Must be sourced last so it wraps every widget defined above.
[[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
