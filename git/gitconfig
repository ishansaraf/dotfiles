[user]
	name = Ishan Saraf
	email = ishan.saraf@bedrockrobotics.com
[core]
	editor = hx
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	dark = true
	# Gruvbox Material diff backgrounds.
	minus-style = syntax "#3c1f1e"
	minus-emph-style = syntax "#5c2a28"
	plus-style = syntax "#34381b"
	plus-emph-style = syntax "#4a5223"
	line-numbers-minus-style = "#ea6962"
	line-numbers-plus-style = "#a9b665"
	line-numbers-zero-style = "#7c6f64"
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictstyle = zdiff3
[pull]
	ff = only
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	updateRefs = true
	autoStash = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[alias]
	st = status -sb
	co = checkout
	sw = switch
	lg = log --graph --oneline --decorate
	amend = commit --amend --no-edit
	wt = worktree
