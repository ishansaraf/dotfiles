#!/usr/bin/env bash
# Devbox bootstrap. cloud-init runs ~/personalize (a symlink to this file) as
# `ubuntu` on every box launch; output lands in ~/.personalize.log. /home is a
# persistent EBS volume but the root disk is not, so apt packages and the login
# shell are redone each launch while ~/.local installs are skipped when current.
# Safe to re-run by hand after editing.
set -euo pipefail

DOTFILES="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
HELIX_VERSION=25.07.1
STARSHIP_VERSION=1.26.0
# Node for the npm-distributed language servers; kept off PATH so it never
# shadows the repo's hermetic node. typescript-language-server 6 needs >=22.22.2.
NODE_VERSION=22.23.2
RUST_ANALYZER_VERSION=2026-09-21
# pyright and biome match the versions dirt's CI uses (pyproject.toml, pnpm-lock.yaml).
LSP_NPM_PACKAGES=(
  pyright@1.1.400
  @biomejs/biome@2.3.15
  typescript@5.9.3
  typescript-language-server@6.0.1
  yaml-language-server@1.24.0
)
ARCH="$(uname -m)"
NODE_ARCH="$(case "$ARCH" in x86_64) echo x64 ;; aarch64) echo arm64 ;; *) echo "$ARCH" ;; esac)"

APT_PACKAGES=(
  zsh zsh-autosuggestions zsh-syntax-highlighting
  fzf fd-find bat eza zoxide git-delta
  mosh btop ncdu gh
)

log() { printf '\n==> %s\n' "$*"; }

link() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "$dst")"
  if [[ -e "$dst" && ! -L "$dst" ]]; then
    mv "$dst" "$dst.pre-dotfiles.$(date +%s)"
  fi
  ln -sfn "$src" "$dst"
}

install_apt_packages() {
  log "apt packages"
  if [[ ! -f /etc/apt/sources.list.d/github-cli.list ]]; then
    sudo mkdir -p -m 755 /etc/apt/keyrings
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
    sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      | sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
  fi
  sudo apt-get update -q
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q "${APT_PACKAGES[@]}"
}

install_helix() {
  local prefix="$HOME/.local/opt/helix-$HELIX_VERSION"
  if [[ ! -x "$prefix/hx" ]]; then
    log "helix $HELIX_VERSION"
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL -o "$tmp/helix.tar.xz" \
      "https://github.com/helix-editor/helix/releases/download/$HELIX_VERSION/helix-$HELIX_VERSION-$ARCH-linux.tar.xz"
    mkdir -p "$prefix"
    tar -xJf "$tmp/helix.tar.xz" -C "$prefix" --strip-components=1
    rm -rf "$tmp"
  fi
  # hx finds its runtime/ next to the resolved binary, so a symlink is enough.
  link "$prefix/hx" "$HOME/.local/bin/hx"
}

install_starship() {
  if [[ "$("$HOME/.local/bin/starship" --version 2>/dev/null | head -1)" != "starship $STARSHIP_VERSION" ]]; then
    log "starship $STARSHIP_VERSION"
    local tmp asset
    tmp="$(mktemp -d)"
    asset="starship-$ARCH-unknown-linux-musl.tar.gz"
    curl -fsSL -o "$tmp/$asset" "https://github.com/starship/starship/releases/download/v$STARSHIP_VERSION/$asset"
    curl -fsSL -o "$tmp/$asset.sha256" "https://github.com/starship/starship/releases/download/v$STARSHIP_VERSION/$asset.sha256"
    (cd "$tmp" && echo "$(cat "$asset.sha256")  $asset" | sha256sum -c --quiet)
    mkdir -p "$HOME/.local/bin"
    tar -xzf "$tmp/$asset" -C "$HOME/.local/bin" starship
    rm -rf "$tmp"
  fi
}

install_node() {
  local name="node-v$NODE_VERSION-linux-$NODE_ARCH"
  local prefix="$HOME/.local/opt/$name"
  if [[ ! -x "$prefix/bin/node" ]]; then
    log "node $NODE_VERSION"
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL -o "$tmp/$name.tar.xz" "https://nodejs.org/dist/v$NODE_VERSION/$name.tar.xz"
    curl -fsSL -o "$tmp/SHASUMS256.txt" "https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt"
    (cd "$tmp" && grep " $name.tar.xz\$" SHASUMS256.txt | sha256sum -c --quiet)
    mkdir -p "$HOME/.local/opt"
    tar -xJf "$tmp/$name.tar.xz" -C "$HOME/.local/opt"
    rm -rf "$tmp"
  fi
  link "$prefix" "$HOME/.local/opt/node"
}

install_npm_language_servers() {
  local prefix="$HOME/.local/opt/lsp" stamp
  stamp="$NODE_VERSION ${LSP_NPM_PACKAGES[*]}"
  if [[ "$(cat "$prefix/.stamp" 2>/dev/null)" != "$stamp" ]]; then
    log "npm language servers: ${LSP_NPM_PACKAGES[*]}"
    rm -rf "$prefix"
    mkdir -p "$prefix"
    PATH="$HOME/.local/opt/node/bin:$PATH" npm install --silent --no-fund --no-audit \
      --prefix "$prefix" --save-exact "${LSP_NPM_PACKAGES[@]}"
    echo "$stamp" >"$prefix/.stamp"
  fi
  # Wrappers instead of symlinks: the npm shims run `env node`, which must
  # resolve to this node rather than whatever is first on PATH.
  local bin
  for bin in pyright-langserver biome typescript-language-server yaml-language-server; do
    rm -f "$HOME/.local/bin/$bin"
    cat >"$HOME/.local/bin/$bin" <<EOF
#!/bin/sh
PATH="$HOME/.local/opt/node/bin:\$PATH" exec "$prefix/node_modules/.bin/$bin" "\$@"
EOF
    chmod +x "$HOME/.local/bin/$bin"
  done
}

# Single-binary editor tools from GitHub releases, pinned by sha256. yamlfmt
# matches the version and checksums in dirt's MODULE.bazel.
# Each entry: name version url-template sha-x86_64 sha-aarch64. In the URL,
# {v} is the version and {a} the per-project arch label from arch_label.
STANDALONE_TOOLS=(
  "rust-analyzer $RUST_ANALYZER_VERSION https://github.com/rust-lang/rust-analyzer/releases/download/{v}/rust-analyzer-{a}-unknown-linux-gnu.gz b2d24ce2bda2ea05b1ad7c2917d205f8111775f703ccd908e6061803ae8257d0 32a75657041a7a2ebf635c1e3968753e2639778b68dd4fb13c4b2584255f2ba8"
  "starpls v0.1.22 https://github.com/withered-magic/starpls/releases/download/{v}/starpls-linux-{a} 7c661cdde0d1c026665086d07523d825671e29056276681616bb32d0273c5eab 55877ec4c3ff03e1d90d59c76f69a3a144b6c29688747c8ac4d77993e2eef1ad"
  "marksman 2026-02-08 https://github.com/artempyanykh/marksman/releases/download/{v}/marksman-linux-{a} be5098e8213219269c47fc0d916a66fa31ce0602ec967475c722260aabf26087 db8e124527f7f8048e3e6c91821b9c52ef173d92c01e47d221bf1337afd962fb"
  "yamlfmt 0.17.2 https://github.com/google/yamlfmt/releases/download/v{v}/yamlfmt_{v}_Linux_{a}.tar.gz b114115b6804cfd203195d222558e4feb38e311fffb590c4e13642fa21bd0e37 1785b9751af9dca10a8a3e51ee2f6f3aa64564610dcc994d98421e28d02b56b5"
  "taplo 0.10.0 https://github.com/tamasfe/taplo/releases/download/{v}/taplo-linux-{a}.gz 8fe196b894ccf9072f98d4e1013a180306e17d244830b03986ee5e8eabeb6156 033681d01eec8376c3fd38fa3703c79316f5e14bb013d859943b60a07bccdcc3"
)

# rust-analyzer is the standalone release, not the toolchain's rust-analyzer
# component: that one is dynamically linked against a librustc_driver that only
# ships with rustc.
arch_label() {
  case "$1:$ARCH" in
    starpls:x86_64) echo amd64 ;;
    marksman:x86_64) echo x64 ;;
    marksman:aarch64) echo arm64 ;;
    yamlfmt:aarch64) echo arm64 ;;
    *) echo "$ARCH" ;;
  esac
}

install_standalone_tools() {
  local entry name version url sha_x86 sha_arm sha prefix tmp
  for entry in "${STANDALONE_TOOLS[@]}"; do
    read -r name version url sha_x86 sha_arm <<<"$entry"
    prefix="$HOME/.local/opt/$name-$version"
    if [[ ! -x "$prefix/$name" ]]; then
      log "$name $version"
      case "$ARCH" in x86_64) sha="$sha_x86" ;; aarch64) sha="$sha_arm" ;; esac
      url="${url//\{v\}/$version}"
      url="${url//\{a\}/$(arch_label "$name")}"
      tmp="$(mktemp -d)"
      curl -fsSL -o "$tmp/download" "$url"
      echo "$sha  $tmp/download" | sha256sum -c --quiet
      mkdir -p "$prefix"
      if [[ "$url" == *.tar.gz ]]; then
        tar -xzf "$tmp/download" -C "$prefix" "$name"
      elif [[ "$url" == *.gz ]]; then
        gunzip -c "$tmp/download" >"$prefix/$name"
      else
        mv "$tmp/download" "$prefix/$name"
      fi
      chmod +x "$prefix/$name"
      rm -rf "$tmp"
    fi
    link "$prefix/$name" "$HOME/.local/bin/$name"
  done
}

link_dotfiles() {
  log "linking dotfiles"
  link "$DOTFILES/zsh/zshrc" "$HOME/.zshrc"
  link "$DOTFILES/tmux/tmux.conf" "$HOME/.tmux.conf"
  link "$DOTFILES/starship.toml" "$HOME/.config/starship.toml"
  link "$DOTFILES/helix" "$HOME/.config/helix"
  link "$DOTFILES/personalize" "$HOME/personalize"
  # Ubuntu ships these under different names to avoid package conflicts.
  link /usr/bin/fdfind "$HOME/.local/bin/fd"
  link /usr/bin/batcat "$HOME/.local/bin/bat"
  # ~/.gitconfig stays as the machine-local file (git lfs writes to it); ours is included.
  if ! git config --global --get-all include.path | grep -qxF "$DOTFILES/git/gitconfig"; then
    git config --global --add include.path "$DOTFILES/git/gitconfig"
  fi
}

install_tmux_plugins() {
  log "tmux plugins"
  if [[ ! -d "$HOME/.tmux/plugins/tpm" ]]; then
    git clone -q --depth 1 https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
  fi
  "$HOME/.tmux/plugins/tpm/bin/install_plugins" >/dev/null
}

tune_dirt_repo() {
  local repo="$HOME/dirt"
  [[ -d "$repo/.git" ]] || return 0
  log "git tuning for $repo"
  git -C "$repo" config feature.manyFiles true
  git -C "$repo" config core.untrackedCache true
  git -C "$repo" config core.fsmonitor true
  link "$DOTFILES/helix/dirt-languages.toml" "$repo/.helix/languages.toml"
  grep -qxF "/.helix/" "$repo/.git/info/exclude" 2>/dev/null || echo "/.helix/" >>"$repo/.git/info/exclude"
}

set_login_shell() {
  local zsh_path
  zsh_path="$(command -v zsh)"
  if [[ "$(getent passwd "$USER" | cut -d: -f7)" != "$zsh_path" ]]; then
    log "login shell -> $zsh_path"
    sudo chsh -s "$zsh_path" "$USER"
  fi
}

install_apt_packages
install_helix
install_starship
install_node
install_npm_language_servers
install_standalone_tools
link_dotfiles
install_tmux_plugins
tune_dirt_repo
set_login_shell
log "done"
